#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bin_path="${PEEKABOO_INSTALL_PATH:-$HOME/.local/bin/peekaboo}"
build_path="$repo_root/Apps/CLI/.build/release/peekaboo"

cd "$repo_root/Apps/CLI"
swift build --configuration release

mkdir -p "$(dirname -- "$bin_path")"
if [ -L "$bin_path" ]; then
  if command -v trash >/dev/null 2>&1; then
    trash "$bin_path"
  else
    /bin/rm -f "$bin_path"
  fi
fi
install -m 755 "$build_path" "$bin_path"

echo "Installed $bin_path"
"$bin_path" --version
